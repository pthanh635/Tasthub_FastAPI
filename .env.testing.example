# Testing Environment Configuration (.env.testing)
APP_ENV=testing
APP_NAME="TaskHub API (Test)"
DEBUG=false
DOCS_ENABLED=true

DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/taskhub
TEST_DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/taskhub_test
REDIS_URL=redis://localhost:6379/15
CACHE_TTL_SECONDS=5

JWT_SECRET_KEY=taskhub-testing-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1

SEED_ADMIN_EMAIL=owner@taskhub.dev
SEED_ADMIN_PASSWORD=TestSeedAdminPassword123!
