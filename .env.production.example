# Production Environment Configuration (.env.production)
# IMPORTANT: DEBUG must be false, JWT_SECRET_KEY must not be a placeholder,
# and DATABASE_URL must not use default 'changeme' credentials.
APP_ENV=production
APP_NAME="TaskHub API"
DEBUG=false
DOCS_ENABLED=false

DATABASE_URL=postgresql+asyncpg://taskhub_prod_user:REPLACE_WITH_STRONG_PASSWORD@db.internal:5432/taskhub_prod
REDIS_URL=rediss://redis.internal:6379/0
CACHE_TTL_SECONDS=60

JWT_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_BYTE_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

SEED_ADMIN_EMAIL=admin@taskhub.company.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
