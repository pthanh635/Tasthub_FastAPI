# Application Settings
APP_NAME="TaskHub API"
DEBUG=false

# PostgreSQL Async Connection URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/taskhub
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=30

# Dedicated Test Database URL (never point to development or production DB)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/taskhub_test

# JWT & Security Settings (jwt_secret_key is required, min 32 characters)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Seed Admin Account
SEED_ADMIN_EMAIL=owner@taskhub.dev
SEED_ADMIN_PASSWORD=
